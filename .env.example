# Společné klubové heslo: ověří se před každým přihlášením přes Discord.
# Nastavení aplikace a nové členské databáze: DISCORD_SETUP.md
CLUB_PASSWORD=zmente-me-na-vlastni-pozvanku

# Port a adresa, na kterých server poslouchá.
PORT=3000
HOST=127.0.0.1

# Adresář s databází a katalogem (výchozí: ./data).
# Na hostingu nastavte na trvalý svazek (persistent volume).
#DATA_DIR=./data

# Nastavte na true, když server běží za HTTPS reverzní proxy
# (cookie pak dostane příznak Secure).
#COOKIE_SECURE=false

# Přihlášení přes Discord OAuth2. Bez konfigurace je přihlášení vypnuté.
# V Discord Developer Portal vytvořte
# aplikaci a nastavte OAuth2 redirect URL přesně na:
# http://localhost:3000/api/auth/discord/callback
# DISCORD_REDIRECT_URI musí přesně odpovídat URL registrované u Discordu.
# Tajný klíč patří pouze sem na server, nikdy do frontendu ani repozitáře.
#DISCORD_CLIENT_ID=
#DISCORD_CLIENT_SECRET=
#DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback
